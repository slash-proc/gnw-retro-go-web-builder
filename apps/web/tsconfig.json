{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["svelte", "vite/client"],
    // Mirror vite.config.ts's @gnw alias so svelte-check type-checks against THIS checkout's
    // packages rather than whatever `node_modules` points at (see the comment there).
    "paths": { "@gnw/*": ["../../packages/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
