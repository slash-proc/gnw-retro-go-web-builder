# Dependencies
node_modules/
# ...and as a SYMLINK. The trailing-slash form matches directories only, so the
# per-worktree symlinks the agent setup creates were committable — one did get
# committed, and merging it replaced the real apps/web/node_modules with a
# self-referential link that broke every esbuild-based suite.
node_modules
.pnp
.pnp.js

# Build output
dist/
dist
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Env / editor
.env
.env.local
.DS_Store
.idea/
.vscode/

# References + device backups + scratch are local working-copy material, NOT tracked.
# We actively develop retro-go under references/ on our own branch, so it is a plain
# working clone (not a pinned submodule). Pinned SHAs at un-tracking time are recorded
# in docs/DEVELOPMENT.md for reproducibility.
references/
backup/
lzmatest/

# Locally-built retro-go firmware blobs (rebuildable from references/, see DEVELOPMENT.md)
blobs/

# Patch oracle output: reference patched images + liblzma vectors are derived
# from copyrighted stock firmware — local validation artifacts, never committed.
packages/gnw-patch/test/ref/

# Visual preview screenshots (dev tooling)
apps/web/preview-*.png

# Generated fs-builders validation artifacts (images, oracle outputs)
packages/fs-builders/test/ref/
packages/fs-builders/test/ref-staging/
packages/fs-builders/test/ref-romlzma/

# Transient agent worktrees created by assistant tooling
.claude/worktrees/

# Agent worktrees (transient, created by the assistant)
.worktrees/

# electron-builder output (desktop/build/web is already covered by the build/ rule above)
desktop/release/
__pycache__/
